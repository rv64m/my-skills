# Optimizer model — judges responses, analyzes failures, rewrites prompts
# When OPENAI_BASE_URL is set, a bare model name (e.g. "deepseek-chat") is
# automatically prefixed with "openai/" so litellm routes it correctly.
OPTIMIZER_MODEL=gpt-4o

# Executor model — runs the prompt under test (isolated to avoid self-grading bias)
# Can be a cheaper/faster model since it only needs to follow the prompt, not evaluate it
EXECUTOR_MODEL=gpt-4o-mini

# OpenAI (or any OpenAI-compatible provider)
OPENAI_API_KEY=sk-...
# Optional: override the base URL for OpenAI-compatible APIs (e.g. DeepSeek, Azure, local models)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
